# Ai-morphasis Environment Configuration
# Copy this file to .env and customize as needed

# Application
DEBUG=false
LOG_LEVEL=INFO

# Agent Configuration
MAX_AGENTS=100
AGENT_MEMORY_SIZE=10000

# Game Configuration
GAME_WIDTH=1280
GAME_HEIGHT=720
TARGET_FPS=60

# Model Configuration
MODEL_DEVICE=cpu
BATCH_SIZE=32
LEARNING_RATE=0.001

# Task Store Backends
TASK_STORE_BACKEND=inmemory
TASK_STORE_POSTGRES_DSN=dbname=automation user=postgres host=localhost port=5432
TASK_STORE_POSTGRES_TABLE=tasks
TASK_STORE_REDIS_URL=redis://localhost:6379/0
TASK_STORE_KEY_PREFIX=agent

# Security / Secrets
APP_SECRET_KEY=change-me
AGENT_AUTH_SECRET=change-me
ENCRYPTION_KEY=

# Logging
LOG_FILE=logs/ai_morphasis.log
